# Archmage — editor normalization (works alongside .vscode/settings.json;
# also covers Vim/Emacs/Sublime/JetBrains contributors).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are meaningful hard line-breaks in Markdown.
trim_trailing_whitespace = false

[*.{ts,tsx,js,mjs,jsx}]
indent_size = 2
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{prisma,sql}]
indent_size = 2

[Makefile]
indent_style = tab
